{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "HangfireSettings": {
    // Executes nightly at 02:00 AM server time. 
    // Responsible for rotating database logs, scrubbing stale cache entries, and removing expired data.
    "DataRetentionCleanupCron": "0 2 * * *",

    // Executes every 1 minute. 
    // Acts as the primary Outbox distributor by polling the database for 'Pending' tasks and pushing them to concurrent background worker threads.
    "SmsQueueProcessorCron": "*/1 * * * *"
  },
